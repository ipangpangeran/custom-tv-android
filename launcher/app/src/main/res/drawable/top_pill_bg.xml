<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF4A2E1B" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <!-- Reorder button while reorder mode is on (focus is on the tiles then). -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#334A2E1B" />
            <stroke android:width="1.5dp" android:color="#FF4A2E1B" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A4A2E1B" />
            <stroke android:width="1.2dp" android:color="#4D4A2E1B" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
